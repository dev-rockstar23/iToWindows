<Window x:Class="PCUnlockManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PCUnlockManagement"
        Title="PCUnlock — Paired Devices"
        Width="680" Height="520"
        MinWidth="520" MinHeight="400"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Convert empty string to Collapsed, non-empty to Visible -->
        <local:StringToVisibilityConverter x:Key="StrToVis"/>
        <!-- Convert bool true→Visible, false→Collapsed -->
        <local:BoolToVisibilityConverter   x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="Auto"/>   <!-- status bar -->
            <RowDefinition Height="*"/>      <!-- device list -->
            <RowDefinition Height="Auto"/>   <!-- action buttons -->
        </Grid.RowDefinitions>

        <!-- ── Header ──────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Paired iPhones"
                       FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Manage which iPhones can unlock this PC."
                       FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ── Status message ──────────────────────────────────────────── -->
        <Border Grid.Row="1"
                Background="#FFF4CE" BorderBrush="#F0C800"
                BorderThickness="1" CornerRadius="4"
                Padding="12,8" Margin="0,0,0,12"
                Visibility="{Binding StatusMessage,
                             Converter={StaticResource StrToVis}}">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#5D4037" FontSize="13"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- ── Device list ─────────────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="4">
            <Grid>
                <!-- Empty state -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="{Binding IsEmpty,
                                         Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="No paired iPhones"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Open PCUnlock on your iPhone to pair it with this PC."
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Loading spinner -->
                <TextBlock Text="Loading…"
                           FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsLoading,
                                        Converter={StaticResource BoolToVis}}"/>

                <!-- Device list view -->
                <ListView x:Name="DeviceListView"
                          ItemsSource="{Binding Devices}"
                          SelectedItem="{Binding SelectedDevice}"
                          ItemContainerStyle="{StaticResource DeviceListItem}"
                          Background="Transparent"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Device Name" Width="220"
                                            DisplayMemberBinding="{Binding DeviceName}"/>
                            <GridViewColumn Header="Device ID" Width="200"
                                            DisplayMemberBinding="{Binding DeviceId}"/>
                            <GridViewColumn Header="Paired" Width="160"
                                            DisplayMemberBinding="{Binding PairedAt}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <!-- ── Action buttons ──────────────────────────────────────────── -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Refresh -->
            <Button Grid.Column="1"
                    Content="Refresh"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding RefreshCommand}"
                    Width="90"/>

            <!-- Remove (requires a selection) -->
            <Button Grid.Column="3"
                    Content="Remove Device"
                    Style="{StaticResource DangerButton}"
                    Command="{Binding RemoveDeviceCommand}"
                    Width="130"/>

            <!-- Remove lost device (requires Windows re-auth) -->
            <Button Grid.Column="5"
                    Content="Remove Lost Device…"
                    Style="{StaticResource DangerButton}"
                    Command="{Binding RemoveLostDeviceCommand}"
                    Width="160"/>
        </Grid>
    </Grid>
</Window>
