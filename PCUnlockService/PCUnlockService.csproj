<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Feature: pc-unlock — Windows BLE Central service component -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- WinRT / Windows.Devices.Bluetooth requires this -->
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>false</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows Runtime support for Windows.Devices.Bluetooth -->
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.1.3" />
    <!-- ILogger / LogLevel abstractions used by BLECentral -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    <!-- DPAPI: ProtectedData.Protect / Unprotect — Requirements 5.7, 13.4 -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- Windows Service hosting -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

</Project>
